mkdir -p build
clang --target=arm-none-eabi -mcpu=arm1136jf-s -marm -mfloat-abi=soft -ffreestanding -fno-builtin -fno-stack-protector -fno-pic -fno-pie -c src/boot/start.S -o build/boot/start.o
clang --target=arm-none-eabi -mcpu=arm1136jf-s -marm -mfloat-abi=soft -ffreestanding -fno-builtin -fno-stack-protector -fno-pic -fno-pie -c src/exceptions/vectors.S -o build/exceptions/vectors.o
clang --target=arm-none-eabi -mcpu=arm1136jf-s -marm -mfloat-abi=soft -ffreestanding -fno-builtin -fno-stack-protector -fno-pic -fno-pie -std=c11 -O2 -g -Iinclude -Wall -Wextra -Werror -c src/exceptions/handlers.c -o build/exceptions/handlers.o
clang --target=arm-none-eabi -mcpu=arm1136jf-s -marm -mfloat-abi=soft -ffreestanding -fno-builtin -fno-stack-protector -fno-pic -fno-pie -std=c11 -O2 -g -Iinclude -Wall -Wextra -Werror -c src/drivers/pl011.c -o build/drivers/pl011.o
clang --target=arm-none-eabi -mcpu=arm1136jf-s -marm -mfloat-abi=soft -ffreestanding -fno-builtin -fno-stack-protector -fno-pic -fno-pie -c src/tests/faults.S -o build/tests/faults.o
clang --target=arm-none-eabi -mcpu=arm1136jf-s -marm -mfloat-abi=soft -ffreestanding -fno-builtin -fno-stack-protector -fno-pic -fno-pie -std=c11 -O2 -g -Iinclude -Wall -Wextra -Werror -c src/tests/scenarios.c -o build/tests/scenarios.o
clang --target=arm-none-eabi -mcpu=arm1136jf-s -marm -mfloat-abi=soft -ffreestanding -fno-builtin -fno-stack-protector -fno-pic -fno-pie -std=c11 -O2 -g -Iinclude -Wall -Wextra -Werror -DMINIT_TEST_SCENARIO=0 -c src/kernel/main.c -o build/main-normal.o
clang --target=arm-none-eabi -mcpu=arm1136jf-s -marm -mfloat-abi=soft -nostdlib -static -fuse-ld=lld -Wl,-T,linker/integratorcp.ld -Wl,--build-id=none build/boot/start.o build/exceptions/vectors.o build/exceptions/handlers.o build/drivers/pl011.o build/tests/faults.o build/tests/scenarios.o build/main-normal.o -Wl,-Map,build/minitos-k2-normal.map -o build/minitos-k2-normal.elf
clang --target=arm-none-eabi -mcpu=arm1136jf-s -marm -mfloat-abi=soft -ffreestanding -fno-builtin -fno-stack-protector -fno-pic -fno-pie -std=c11 -O2 -g -Iinclude -Wall -Wextra -Werror -DMINIT_TEST_SCENARIO=1 -c src/kernel/main.c -o build/main-undef.o
clang --target=arm-none-eabi -mcpu=arm1136jf-s -marm -mfloat-abi=soft -nostdlib -static -fuse-ld=lld -Wl,-T,linker/integratorcp.ld -Wl,--build-id=none build/boot/start.o build/exceptions/vectors.o build/exceptions/handlers.o build/drivers/pl011.o build/tests/faults.o build/tests/scenarios.o build/main-undef.o -Wl,-Map,build/minitos-k2-undef.map -o build/minitos-k2-undef.elf
clang --target=arm-none-eabi -mcpu=arm1136jf-s -marm -mfloat-abi=soft -ffreestanding -fno-builtin -fno-stack-protector -fno-pic -fno-pie -std=c11 -O2 -g -Iinclude -Wall -Wextra -Werror -DMINIT_TEST_SCENARIO=2 -c src/kernel/main.c -o build/main-data-abort.o
clang --target=arm-none-eabi -mcpu=arm1136jf-s -marm -mfloat-abi=soft -nostdlib -static -fuse-ld=lld -Wl,-T,linker/integratorcp.ld -Wl,--build-id=none build/boot/start.o build/exceptions/vectors.o build/exceptions/handlers.o build/drivers/pl011.o build/tests/faults.o build/tests/scenarios.o build/main-data-abort.o -Wl,-Map,build/minitos-k2-data-abort.map -o build/minitos-k2-data-abort.elf
llvm-objcopy -O binary build/minitos-k2-normal.elf build/minitos-k2-normal.bin
llvm-objcopy -O binary build/minitos-k2-undef.elf build/minitos-k2-undef.bin
llvm-objcopy -O binary build/minitos-k2-data-abort.elf build/minitos-k2-data-abort.bin
readelf -h build/minitos-k2-normal.elf | grep -E 'Class:.*ELF32|Machine:.*ARM|Entry point address:'
  Class:                             ELF32
  Machine:                           ARM
  Entry point address:               0x10000
readelf -h build/minitos-k2-normal.elf | grep -E 'Flags:'
  Flags:                             0x5000200, Version5 EABI, soft-float ABI
readelf -l build/minitos-k2-normal.elf | grep -E 'LOAD'
  LOAD           0x010000 0x00000000 0x00000000 0x00020 0x00020 R E 0x10000
  LOAD           0x020000 0x00010000 0x00010000 0x00dbc 0x00dbc R E 0x10000
  LOAD           0x020dbc 0x00010dbc 0x00010dbc 0x0000c 0x03014 RW  0x10000
readelf -s build/minitos-k2-normal.elf | grep -E '_start|kmain|minit_exception_dispatch|_vector_table'
    28: 00010000   156 FUNC    GLOBAL DEFAULT    2 _start
    29: 0001071c   588 FUNC    GLOBAL DEFAULT    2 kmain
    36: 00010dc8     0 NOTYPE  GLOBAL DEFAULT    5 __bss_start__
    38: 00000000    32 OBJECT  GLOBAL DEFAULT    1 _vector_table
